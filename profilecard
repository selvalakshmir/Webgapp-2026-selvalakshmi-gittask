<!DOCTYPE html>
<html>
<head>
    <title>Selvalakshmi Profile Card</title>

    <style>
        .profile-card {
            width: 320px;
            background-color: white;
            text-align: center;
            padding: 30px 20px;
            border: 1px solid lightgray;
            border-radius: 15px;
            box-shadow: 0 5px 20px lightgray;
            font-family: Arial, sans-serif;
            margin: 50px auto;
        }

        .profile-card img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid blue;
            margin-bottom: 15px;
        }

        .profile-card h2 {
            font-size: 24px;
            color: black;
            margin-bottom: 8px;
        }

        .profile-card h4 {
            color: blue;
            font-size: 16px;
            margin-bottom: 15px;
        }

        .profile-card p {
            color: gray;
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 20px;
        }

        .social-links a {
            display: inline-block;
            background-color: blue;
            color: white;
            padding: 10px 15px;
            margin: 5px;
            border-radius: 5px;
            text-decoration: none;
            font-size: 13px;
        }

        .profile-card:hover {
            transform: translateY(-5px);
        }

        .social-links a:hover {
            background-color: darkblue;
        }
    </style>
</head>

<body>

    <div class="profile-card">

        <img src="https://i.pravatar.cc/300"
             alt="Profile Photo">

        <h2>Selvalakshmi</h2>

        <h4>Web Developer</h4>

        <p>
            I am a passionate web developer
            interested in creating beautiful and
            user-friendly websites using HTML,
            CSS and JavaScript.
        </p>

        <div class="social-links">
            <a href="https://www.linkedin.com/in/selvalakshmi-rajapandian-3153b9380/"
               target="_blank">LinkedIn</a>

            <a href="https://github.com/"
               target="_blank">GitHub</a>

            <a href="https://www.instagram.com/"
               target="_blank">Instagram</a>
        </div>

    </div>

</body>
</html>